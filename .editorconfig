# EditorConfig - consistent formatting across editors (https://editorconfig.org)
# Standard for docs + code writers on this project.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# 2-space indent for these formats
[*.{json,jsonc,yml,yaml,css,scss,html}]
indent_size = 2

# Markdown: preserve trailing spaces (they are significant line breaks),
# no hard line length, no reformatting.
[*.md]
trim_trailing_whitespace = false
max_line_length = off
